{
  "name": "document-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "prototype": "python -m http.server 4173 -d apps/prototype",
    "validate": "python scripts/validate_repo.py",
    "check:links": "python scripts/check_links.py",
    "typecheck": "npm --workspace apps/desktop run typecheck",
    "test": "npm --workspace apps/desktop test"
  },
  "engines": {
    "node": ">=22"
  }
}
