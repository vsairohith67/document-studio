{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document.studio/schemas/operation.schema.json",
  "title": "Document Studio Operation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "name", "category", "description", "risk", "locality",
    "inputs", "settingsSchema", "outputs", "dependencies", "verification", "stages"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 240 },
    "risk": { "enum": ["normal", "sensitive", "irreversible"] },
    "locality": { "enum": ["local", "local-or-cloud", "cloud"] },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedMimeTypes", "minimum", "maximum", "allowDirectories"],
      "properties": {
        "acceptedMimeTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255 } },
        "minimum": { "type": "integer", "minimum": 1 },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 128 },
        "allowDirectories": { "type": "boolean" }
      }
    },
    "settingsSchema": { "type": "object" },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mimeType", "multiplicity"],
      "properties": {
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 255 },
        "multiplicity": { "enum": ["single", "multiple", "zero-or-one"] }
      }
    },
    "dependencies": { "type": "array", "uniqueItems": true, "maxItems": 32, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" } },
    "verification": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" } },
    "stages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "const": "inspect" }, { "const": "preflight" }, { "const": "estimate" },
        { "const": "plan" }, { "const": "execute" }, { "const": "verify" },
        { "const": "publish" }, { "const": "audit" }, { "const": "cleanup" }
      ],
      "items": false
    }
  }
}
