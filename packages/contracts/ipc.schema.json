{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document.studio/schemas/ipc.schema.json",
  "title": "Document Studio IPC v1",
  "$defs": {
    "batchPreviewRequest": { "$ref": "https://document.studio/schemas/batch.schema.json#/$defs/batchPreviewRequest" },
    "batchCreateRequest": { "$ref": "https://document.studio/schemas/batch.schema.json#/$defs/batchCreateRequest" },
    "batchGetRequest": { "$ref": "https://document.studio/schemas/batch.schema.json#/$defs/batchGetRequest" },
    "jobIdRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId"],
      "properties": { "jobId": { "type": "string", "format": "uuid" } }
    },
    "jobsCreateRequest": {
      "oneOf": [
        { "$ref": "#/$defs/diagnosticCopyCreateRequest" },
        { "$ref": "#/$defs/pdfMergeCreateRequest" },
        { "$ref": "#/$defs/pdfCompressLosslessCreateRequest" },
        { "$ref": "#/$defs/balancedCompressionJobCreateRequest" }
      ]
    },
    "diagnosticCopyCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "inputPaths", "destinationDirectory", "requestedOutputName"],
      "properties": {
        "operationId": { "const": "diagnostic.copy" },
        "inputPaths": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/localPath" } },
        "destinationDirectory": { "$ref": "#/$defs/localPath" },
        "requestedOutputName": { "$ref": "#/$defs/outputName" }
      }
    },
    "pdfMergeCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "inputPaths", "destinationDirectory", "requestedOutputName"],
      "properties": {
        "operationId": { "const": "pdf.merge" },
        "inputPaths": { "type": "array", "minItems": 2, "maxItems": 128, "items": { "$ref": "#/$defs/localPath" } },
        "destinationDirectory": { "$ref": "#/$defs/localPath" },
        "requestedOutputName": { "allOf": [{ "$ref": "#/$defs/outputName" }, { "type": "string", "pattern": "\\.[pP][dD][fF]$" }] }
      }
    },
    "pdfCompressLosslessCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "inputPaths", "destinationDirectory", "requestedOutputName"],
      "properties": {
        "operationId": { "const": "pdf.compress-lossless" },
        "inputPaths": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/localPath" } },
        "destinationDirectory": { "$ref": "#/$defs/localPath" },
        "requestedOutputName": { "allOf": [{ "$ref": "#/$defs/outputName" }, { "type": "string", "pattern": "\\.[pP][dD][fF]$" }] }
      }
    },
    "balancedCompressionJobCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "inputPaths", "destinationDirectory", "requestedOutputName", "settings"],
      "properties": {
        "operationId": { "const": "pdf.compress-balanced" },
        "inputPaths": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/localPath" } },
        "destinationDirectory": { "$ref": "#/$defs/localPath" },
        "requestedOutputName": { "allOf": [{ "$ref": "#/$defs/outputName" }, { "type": "string", "pattern": "\\.[pP][dD][fF]$" }] },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile"],
          "properties": { "profile": { "const": "balanced-v1" } }
        }
      }
    },
    "pdfToImagesJobCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewerSessionId", "viewerGeneration", "destinationGrantId", "sourcePageCount",
        "pages", "format", "dpi", "outputStem"
      ],
      "properties": {
        "viewerSessionId": { "$ref": "#/$defs/uuid" },
        "viewerGeneration": { "type": "integer", "minimum": 1 },
        "destinationGrantId": { "$ref": "#/$defs/uuid" },
        "sourcePageCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "pages": {
          "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/pdfToImagesPagePlan" }
        },
        "format": { "enum": ["jpeg", "png", "webp"] },
        "dpi": { "enum": [72, 150, 300] },
        "outputStem": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "pdfToImagesPagePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePageIndex", "width", "height"],
      "properties": {
        "sourcePageIndex": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "uuid": { "type": "string", "format": "uuid" },
    "localPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32767
    },
    "outputName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "progressEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "sequence", "emittedAt", "jobId", "operationId", "state",
        "stage", "completedUnits", "totalUnits", "unit", "messageCode", "message", "cancellable"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "emittedAt": { "type": "string", "format": "date-time" },
        "jobId": { "type": "string", "format": "uuid" },
        "operationId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
        "state": { "enum": ["queued", "inspecting", "preflight", "ready", "running", "verifying", "publishing", "completed", "failed", "cancelled", "interrupted"] },
        "stage": { "enum": ["inspect", "preflight", "estimate", "plan", "execute", "verify", "publish", "audit", "cleanup", "recovery"] },
        "completedUnits": { "type": "integer", "minimum": 0 },
        "totalUnits": { "type": "integer", "minimum": 0 },
        "unit": { "enum": ["bytes", "items", "steps"] },
        "messageCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 240 },
        "cancellable": { "type": "boolean" }
      }
    }
  }
}
