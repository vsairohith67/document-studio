{
  "name": "@document-studio/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "stage:pdfjs": "node ./scripts/stage-pdfjs-assets.mjs",
    "predev": "npm run stage:pdfjs",
    "dev": "vite",
    "dev:test-browser": "vite --mode test-browser",
    "prebuild": "npm run stage:pdfjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pdfjs-assets": "node ./scripts/test-pdfjs-assets.mjs",
    "test:browser": "playwright test",
    "test:webview2": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-webview2-smoke.ps1",
    "verify:g03": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-g03-boundaries.ps1",
    "verify:g04a": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-g04a-boundaries.ps1",
    "verify:g04b": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-g04b-boundaries.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@document-studio/contracts": "0.1.0",
    "@document-studio/tokens": "0.1.0",
    "@tanstack/react-virtual": "3.14.9",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.2",
    "pdfjs-dist": "6.2.108",
    "react": "~19.2.7",
    "react-dom": "~19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "~2.11.4",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.4",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitejs/plugin-react": "~6.0.3",
    "axe-core": "~4.13.0",
    "jsdom": "~30.0.1",
    "typescript": "~5.8.0",
    "vite": "~8.1.5",
    "vitest": "~4.1.10"
  }
}
