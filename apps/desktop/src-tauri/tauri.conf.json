{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Document Studio",
  "version": "0.1.0",
  "identifier": "studio.document.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title":"Document Studio","width":1280,"height":820,"minWidth":960,"minHeight":640}],
    "security": {"csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"}
  },
  "bundle": {"active":true,"targets":"all"}
}
